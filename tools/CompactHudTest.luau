-- Testa apenas apresentação local, sem remotes, moedas ou personagens.
local StarterPlayer = game:GetService("StarterPlayer")
local UI = StarterPlayer.StarterPlayerScripts.Client.UI
local CompactHUD = require(UI.CompactHUD)
local results = {}
local function check(name, ok)
	table.insert(results, (ok and "PASS " or "FAIL ") .. name)
end
local gui = Instance.new("ScreenGui")
local opened = false
local c = CompactHUD.new(gui, function() opened = true end)
check("resumo criado", c.Root.Name == "CompactSummary")
check("objetivo criado", c.Objective.Name == "QuickObjective")
check("ambos escondidos inicialmente", not c.Root.Visible and not c.Objective.Visible)
c.Fit(500, true, false)
check("status aparece compacto", c.Root.Visible and c.Objective.Visible)
check("status e objetivo cabem no compacto", c.Root.Size.X.Offset <= 342 and c.Objective.Size.X.Offset <= 474)
c.Fit(500, true, true)
check("abrir detalhes recolhe cartão de ação", c.Root.Visible and not c.Objective.Visible)
c.Fit(1672, false, false)
check("desktop usa HUD principal", not c.Root.Visible and not c.Objective.Visible)
c.SetStats(1450, 3, 81)
local coins = c.Root:FindFirstChild("Coins")
local level = c.Root:FindFirstChild("Level")
check("moedas formatadas sem arredondar", coins and coins.Text == "$ 1.450")
check("nível em ordem legível", level and level.Text == "NV 03")
check("reputacao registrada sem ocupar tela", c.Root:GetAttribute("ReputationValue") == 81)
local action = c.Objective:FindFirstChild("Action")
local detail = c.Objective:FindFirstChild("Detail")
c.SetObjective({ Jobs = {} })
check("sem cliente mostra oficina livre", action and action.Text == "OFICINA DISPONÍVEL")
c.SetObjective({ Jobs = { { Status = "Available", VehicleName = "Carro A" } } })
check("fila prioriza cliente", action.Text == "CLIENTE AGUARDANDO" and string.find(detail.Text, "Carro A", 1, true) ~= nil)
c.SetObjective({ Jobs = { { Status = "InProgress", Diagnosed = false, VehicleName = "Carro B" } } })
check("cliente aceito prioriza conversa", action.Text == "DIAGNOSTICAR")
c.SetObjective({ Jobs = { { Status = "InProgress", Diagnosed = true, PrepRequired = true, PrepComplete = false, VehicleName = "Carro B" } } })
check("diagnosticado exige preparo", action.Text == "PREPARAR VEÍCULO")
c.SetObjective({ Jobs = { { Status = "InProgress", Diagnosed = true, PrepRequired = true, PrepComplete = true, ServiceName = "Reparo do motor" } } })
check("preparo finalizado aponta serviço", action.Text == "EXECUTAR REPARO")
gui:Destroy()
return table.concat(results, "\n")
