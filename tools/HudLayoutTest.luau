-- Geometria lógica e toque em telas grandes, pequenas, deitadas e em pé.
local Plan = require(game.ReplicatedStorage.Shared.HudLayoutRules).Plan
local out = {}
local function check(name, ok)
	table.insert(out, (ok and "PASS " or "FAIL ") .. name)
end
local desktop = Plan(Vector2.new(1920, 1080), false)
check("desktop usa trilhos laterais", not desktop.Compact)
check("desktop não fica apertado", not desktop.Tight)
check("desktop largura escala correta", desktop.Scale > 0.9 and desktop.Width >= 1480)
local laptop = Plan(Vector2.new(1366, 768), false)
check("laptop mantém navegação utilizável", laptop.Width > 800 and laptop.Height > 700)
local mobile = Plan(Vector2.new(390, 844), true)
check("celular vertical entra em modo compacto", mobile.Compact and mobile.Tight)
check("dock dentro do viewport", mobile.DockWidth <= mobile.Width - 28)
check("dock vertical tem área para seis itens", mobile.DockContentWidth + 16 <= mobile.DockWidth)
check("alvo touch vertical ao menos 48px", mobile.DockSize * mobile.Scale >= 48)
check("status não encosta nos controles", mobile.StatusWidth + 158 <= mobile.Width)
check("painel de detalhes cabe no vertical", mobile.DetailsWidth <= mobile.Width - 28)
check("detalhes têm área de rolagem", mobile.DetailsHeight > 100)
local tiny = Plan(Vector2.new(320, 568), true)
check("celular pequeno usa scroll horizontal", tiny.DockScrollable)
check("dock pequeno dentro da tela", tiny.DockWidth <= tiny.Width - 28)
check("alvos mantêm tamanho mínimo", tiny.DockSize * tiny.Scale >= 48)
check("conteúdo do dock pequeno maior que área visível", tiny.DockContentWidth + 16 > tiny.DockWidth)
check("celular pequeno mantém status utilizável", tiny.StatusWidth >= 170)
local landscape = Plan(Vector2.new(844, 390), true)
check("celular horizontal usa compacto", landscape.Compact)
check("paisagem baixa tem espaço de detalhe", landscape.DetailsHeight >= 100)
check("escala nunca zera", landscape.Scale >= 0.78)
local tablet = Plan(Vector2.new(1024, 768), true)
check("tablet não tem cortes de nav", tablet.DockSize * 6 + 30 <= tablet.Width)
check("largura da coluna limitada", tablet.DetailsWidth <= 454)
return table.concat(out, "\n")
