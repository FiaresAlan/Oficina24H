-- Regressões para preparação física antes do reparo (executar via RunAllTests no Studio).
local P = require(game.ReplicatedStorage.Shared.RepairPrepRules)
local out = {}
local function check(name, passed)
	table.insert(out, (passed and "PASS " or "FAIL ") .. name)
end

check("pneu exige preparo", P.Requires("FlatTire"))
check("bateria exige preparo", P.Requires("WeakBattery"))
check("arrefecimento exige preparo", P.Requires("Overheating"))
check("demais defeitos mantêm minijogo", not P.Requires("BrakeWear") and not P.Requires("Dent"))
check("pneu começa pelas porcas", P.Current("FlatTire", 1) == "WheelBolts")
check("pneu exige apoio após porcas", P.Current("FlatTire", 2) == "JackSupport")
check("bateria começa no capô", P.Current("WeakBattery", 1) == "HoodRelease")
check("bateria termina no suporte", P.Current("WeakBattery", 2) == "BatteryBracket")
check("arrefecimento termina na bandeja", P.Current("Overheating", 2) == "DrainPan")
check("sem preparo concluído bloqueia reparo", not P.Ready("FlatTire", 1) and not P.Ready("WeakBattery", 2))
check("preparo completo habilita reparo", P.Ready("FlatTire", 3) and P.Ready("WeakBattery", 3) and P.Ready("Overheating", 3))
check("serviço legado não ganha barreira", P.Ready("BrakeWear", nil))
check("etapa inicial progride", P.Advance("FlatTire", 1, "WheelBolts") == 2)
check("etapa final progride", P.Advance("FlatTire", 2, "JackSupport") == 3)
check("não pode pular etapa", P.Advance("FlatTire", 1, "JackSupport") == nil)
check("não pode repetir etapa", P.Advance("FlatTire", 2, "WheelBolts") == nil)
check("etapa de outra receita não funciona", P.Advance("FlatTire", 1, "HoodRelease") == nil)
check("input inválido bloqueado", P.Advance("FlatTire", 1, { Bad = true }) == nil)
check("índice fracionado bloqueado", P.Current("FlatTire", 1.5) == nil and P.Advance("FlatTire", 1.5, "WheelBolts") == nil)
check("índice NaN bloqueado", P.Current("FlatTire", 0 / 0) == nil and not P.Ready("FlatTire", 0 / 0))
check("índice negativo bloqueado", P.Current("FlatTire", -1) == nil)
check("apenas etapas realmente feitas ficam verdes", P.IsDone("FlatTire", 2, "WheelBolts") and not P.IsDone("FlatTire", 2, "JackSupport"))
check("etapa inexistente não fica concluída", not P.IsDone("FlatTire", 3, "HoodRelease"))
check("etapa outra receita não fica concluída", not P.IsDone("WeakBattery", 3, "DrainPan"))
check("prompt da roda reconhecido", P.FromPrompt("Prep_WheelBolts") == "WheelBolts")
check("prompt falso bloqueado", P.FromPrompt("Prep_GrantCoins") == nil and P.FromPrompt("FinishRepair") == nil)
local offsets = P.Offsets(8, 18, 5)
check("cinco sockets do carro disponíveis", offsets.WheelBolts and offsets.JackSupport and offsets.HoodRelease and offsets.BatteryBracket and offsets.DrainPan)
check("pontos do pneu e elevador distintos", offsets.WheelBolts ~= offsets.JackSupport)
check("ponto do capô na frente", offsets.HoodRelease.Z < -8)
check("dimensões inválidas têm fallback", P.Offsets(0 / 0, -math.huge, math.huge).HoodRelease ~= nil)
check("dimensões extremas são limitadas", P.Offsets(10000, 10000, 10000).HoodRelease.Y < 10)
check("dentro da distância permite", P.IsNear(Vector3.new(2, 1, 3), Vector3.new(3, 1, 3), 2))
check("fora da distância não permite", not P.IsNear(Vector3.new(2, 1, 3), Vector3.new(20, 1, 3), 2))
check("sem peça não permite", not P.IsNear(nil, Vector3.new(), 2))
check("distância adulterada não permite", not P.IsNear(Vector3.new(), Vector3.new(), 0/0))
return table.concat(out, "\n")
